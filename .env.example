# Copiază acest fișier ca .env.local pentru dezvoltare locală.
# Pe Vercel, adaugă aceleași valori în Project Settings -> Environment Variables.

APP_USERNAME=stefi
APP_PASSWORD=profesoara

# Recomandat pentru free tier: încearcă Groq, apoi Gemini.
AI_PROVIDER=auto

# Poți pune mai multe chei separate prin virgulă.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# Poți pune mai multe chei separate prin virgulă.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash-lite

# Opțional, dacă vrei să folosești Claude manual.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Opțional, pentru istoric persistent al ideilor.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
